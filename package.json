{
  "name": "robocode",
  "private": true,
  "displayName": "AI Inline + Chat",
  "publisher": "olgert",
  "description": "Code copilot",
  "version": "1.4.8",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "AI"
  ],
  "enabledApiProposals": [
    "extensionRuntime"
  ],
  "icon": "media/robot.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "workspaces": [
    "chat",
    "extension"
  ],
  "scripts": {
    "dev": "nodemon --config ./nodemon.json",
    "package": "vsce package ",
    "list-package": "vsce ls --tree",
    "build": "yarn workspace chat build && yarn workspace extension build",
    "build:chat": "yarn workspace chat build",
    "build:extension": "yarn workspace extension build"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "robocode",
          "title": "Robocode",
          "icon": "media/robot.png"
        }
      ]
    },
    "views": {
      "robocode": [
        {
          "id": "robocodeView",
          "name": "Chat",
          "icon": "media/robot.png",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "robocode.openChat",
        "title": "Open AI Chat",
        "icon": "media/robot.png"
      },
      {
        "command": "robocode.addContextFiles",
        "title": "Add context"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "robocode.openChat",
          "when": "view == robocode.view",
          "group": "navigation",
          "icon": "media/robot.png"
        },
        {
          "command": "robocode.openChat",
          "when": "view == robocode.view",
          "group": "navigation",
          "icon": "media/robot.png"
        }
      ]
    },
    "configuration": {
      "title": "Robocode configurations",
      "properties": {
        "chatConfig.provider": {
          "type": "string"
        },
        "chatConfig.model": {
          "type": "string"
        },
        "chatConfig.endpoint": {
          "type": "string",
          "default": "http://localhost:11434"
        },
        "chatConfig.apiKey": {
          "type": "string"
        },
        "chatConfig.maxTokens": {
          "type": "number"
        },
        "chatConfig.temperature": {
          "type": "number"
        },
        "autoCompleteConfig.provider": {
          "type": "string"
        },
        "autoCompleteConfig.model": {
          "type": "string"
        },
        "autoCompleteConfig.endpoint": {
          "type": "string",
          "default": "http://localhost:11434"
        },
        "autoCompleteConfig.apiKey": {
          "type": "string"
        },
        "autoCompleteConfig.maxTokens": {
          "type": "number"
        },
        "autoCompleteConfig.temperature": {
          "type": "number"
        },
        "autoCompleteConfig.autocompleteDeleay": {
          "type": "number"
        },
        "agentConfig.provider": {
          "type": "string"
        },
        "agentConfig.model": {
          "type": "string"
        },
        "agentConfig.endpoint": {
          "type": "string",
          "default": "http://localhost:11434"
        },
        "agentConfig.apiKey": {
          "type": "string"
        },
        "agentConfig.maxTokens": {
          "type": "number"
        },
        "agentConfig.temperature": {
          "type": "number"
        }
      }
    },
    "keybindings": [
      {
        "command": "robocode.triggerAutocomplete",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "dependencies": {
    "@lancedb/lancedb-darwin-arm64": "^0.22.2",
    "@llamaindex/core": "^0.6.22",
    "@llamaindex/deepseek": "^0.0.38",
    "@llamaindex/huggingface": "^0.1.30",
    "@llamaindex/node-parser": "^2.0.22",
    "@llamaindex/ollama": "^0.1.23",
    "@llamaindex/openai": "^0.4.20",
    "@llamaindex/workflow": "^1.1.24",
    "@xenova/transformers": "^2.14.1",
    "js-tiktoken": "^1.0.21",
    "onnxruntime-node": "^1.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
